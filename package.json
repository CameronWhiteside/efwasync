{
  "name": "efwasync",
  "version": "1.0.1",
  "description": "Go-style [err, result] tuples for TypeScript. efwAsync for promises, efw for sync. Plus an ESLint config that bans try/catch.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./eslint": "./eslint.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "efw.ts",
    "eslint.js",
    "skill"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext types-check.ts"
  },
  "keywords": [
    "error",
    "error-handling",
    "go",
    "tuple",
    "result",
    "typescript",
    "eslint",
    "claude-skill",
    "efw",
    "efwAsync"
  ],
  "author": "Cameron Whiteside",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CameronWhiteside/efwasync.git"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
